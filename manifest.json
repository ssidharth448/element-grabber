{
    "manifest_version": 3,
    "name": "Element Grabber",
    "version": "0.1.0",
    "description": "Select any part of a page and get its HTML and CSS.",
    "permissions": ["storage"],
    "content_scripts": [
      { "matches": ["<all_urls>"], "js": ["content.js"] }
    ],
    "browser_specific_settings": {
      "gecko": { "id": "element-grabber@example.com" }
    }
  }